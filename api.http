### TOBONSITA RAPPI - PRUEBAS DE API ###

# Variables del entorno
@baseUrl = http://localhost:5050
@contentType = application/json

### 1. Verificar que el servidor esté funcionando ###
GET {{baseUrl}}/
Content-Type: {{contentType}}

### 2. Obtener estadísticas iniciales ###
GET {{baseUrl}}/stats
Content-Type: {{contentType}}

### 3. LOGIN - Usuario existente (cliente_demo) ###
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
    "username": "cliente_demo",
    "password": "demo123"
}

### 4. LOGIN - Usuario nuevo (se creará automáticamente) ###
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
    "username": "nuevo_usuario",
    "password": "password123"
}

### 5. LOGIN - Password incorrecto (debe fallar) ###
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
    "username": "cliente_demo",
    "password": "password_incorrecto"
}

### 6. LOGIN TIENDA - Pizzería ###
POST {{baseUrl}}/login-store
Content-Type: {{contentType}}

{
    "username": "pizzas_mario",
    "password": "mario123"
}

### 7. LOGIN TIENDA - Hamburguesas ###
POST {{baseUrl}}/login-store
Content-Type: {{contentType}}

{
    "username": "hambur_express",
    "password": "burger456"
}

### 8. OBTENER TODAS LAS TIENDAS ###
GET {{baseUrl}}/stores
Content-Type: {{contentType}}

### 9. VER MENÚ DE PIZZERÍA MARIO (ID: 200) ###
GET {{baseUrl}}/restaurant/200/menu
Content-Type: {{contentType}}

### 10. VER MENÚ DE HAMBURGUESAS EXPRESS (ID: 201) ###
GET {{baseUrl}}/restaurant/201/menu
Content-Type: {{contentType}}

### 11. ACTIVAR TIENDA DE HAMBURGUESAS ###
PUT {{baseUrl}}/activate-store/201
Content-Type: {{contentType}}

{
    "action": "open"
}

### 12. DESACTIVAR PIZZERÍA ###
PUT {{baseUrl}}/activate-store/200
Content-Type: {{contentType}}

{
    "action": "close"
}

### 13. REACTIVAR PIZZERÍA ###
PUT {{baseUrl}}/activate-store/200
Content-Type: {{contentType}}

{
    "action": "open"
}

### 14. AGREGAR NUEVO PRODUCTO - Pizza Hawaiana ###
POST {{baseUrl}}/products
Content-Type: {{contentType}}

{
    "nombre": "Pizza Hawaiana",
    "precio": 30000,
    "tienda": "Pizzas de Mario",
    "categoria": "Pizza Especial",
    "descripcion": "Pizza con jamón, piña y queso mozzarella",
    "tiempo_preparacion": "18 minutos"
}

### 15. AGREGAR NUEVO PRODUCTO - Hamburguesa BBQ ###
POST {{baseUrl}}/products
Content-Type: {{contentType}}

{
    "id": 403,
    "nombre": "Hamburguesa BBQ",
    "precio": 26000,
    "tienda": "Hamburguesas Express",
    "categoria": "Hamburguesa Especial",
    "descripcion": "Hamburguesa con salsa BBQ, cebolla caramelizada y tocino",
    "imagen": "https://images.unsplash.com/photo-1553979459-d2229ba7433a?w=500&h=400&fit=crop"
}

### 16. VER TODOS LOS PRODUCTOS ###
GET {{baseUrl}}/productos
Content-Type: {{contentType}}

### 17. CREAR ORDEN - Pizza Napolitana ###
POST {{baseUrl}}/orders
Content-Type: {{contentType}}

{
    "producto": "Pizza Napolitana",
    "cliente": "nuevo_usuario",
    "tienda": "Pizzas de Mario",
    "direccion": "Calle 85 #14-23, Apartamento 402",
    "total": 32000
}

### 18. CREAR ORDEN - Hamburguesa Clásica ###
POST {{baseUrl}}/orders
Content-Type: {{contentType}}

{
    "id": 501,
    "producto": "Hamburguesa Clásica",
    "cliente": "cliente_demo",
    "tienda": "Hamburguesas Express",
    "direccion": "Carrera 11 #93-15",
    "total": 24000
}

### 19. CREAR ORDEN - Pizza Hawaiana ###
POST {{baseUrl}}/orders
Content-Type: {{contentType}}

{
    "producto": "Pizza Hawaiana",
    "cliente": "nuevo_usuario",
    "direccion": "Avenida 68 #45-23"
}

### 20. VER TODAS LAS ÓRDENES ###
GET {{baseUrl}}/orders
Content-Type: {{contentType}}

### 21. VER ÓRDENES (usando alias /pedidos) ###
GET {{baseUrl}}/pedidos
Content-Type: {{contentType}}

### 22. ACTUALIZAR ORDEN A ACEPTADO ###
PUT {{baseUrl}}/orders/500
Content-Type: {{contentType}}

{
    "estado": "aceptado"
}

### 23. ACTUALIZAR ORDEN A EN CAMINO ###
PUT {{baseUrl}}/orders/501
Content-Type: {{contentType}}

{
    "estado": "en_camino"
}

### 24. ACTUALIZAR ORDEN A ENTREGADO ###
PUT {{baseUrl}}/pedidos/500
Content-Type: {{contentType}}

{
    "estado": "entregado"
}

### 25. VER ESTADÍSTICAS ACTUALIZADAS ###
GET {{baseUrl}}/stats
Content-Type: {{contentType}}

### 26. PRUEBA DE ERROR - Producto con ID duplicado ###
POST {{baseUrl}}/products
Content-Type: {{contentType}}

{
    "id": 400,
    "nombre": "Producto Duplicado",
    "precio": 15000,
    "tienda": "Pizzas de Mario"
}

### 27. PRUEBA DE ERROR - Orden con ID duplicado ###
POST {{baseUrl}}/orders
Content-Type: {{contentType}}

{
    "id": 500,
    "producto": "Pizza Test",
    "cliente": "test_user"
}

### 28. PRUEBA DE ERROR - Login sin contraseña ###
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
    "username": "test_user"
}

### 29. PRUEBA DE ERROR - Producto sin nombre ###
POST {{baseUrl}}/products
Content-Type: {{contentType}}

{
    "precio": 20000,
    "tienda": "Test Store"
}

### 30. PRUEBA DE ERROR - Orden sin cliente ###
POST {{baseUrl}}/orders
Content-Type: {{contentType}}

{
    "producto": "Pizza Test"
}

### 31. PRUEBA DE ERROR - Actualizar orden inexistente ###
PUT {{baseUrl}}/orders/9999
Content-Type: {{contentType}}

{
    "estado": "entregado"
}

### 32. PRUEBA DE ERROR - Estado inválido ###
PUT {{baseUrl}}/orders/501
Content-Type: {{contentType}}

{
    "estado": "estado_inexistente"
}

### 33. PRUEBA DE ERROR - Tienda inexistente ###
GET {{baseUrl}}/restaurant/9999/menu
Content-Type: {{contentType}}

### 34. PRUEBA DE ERROR - Activar tienda inexistente ###
PUT {{baseUrl}}/activate-store/9999
Content-Type: {{contentType}}

{
    "action": "open"
}

### 35. PRUEBA DE ERROR - Ruta inexistente ###
GET {{baseUrl}}/ruta-que-no-existe
Content-Type: {{contentType}}

